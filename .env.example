# ==========================================================================
# API Proxy – Environment Configuration
#
# Copy this file:  cp .env.example .env
# Then fill in the three credential values below.
# Everything else is pre-configured with sensible defaults.
# ==========================================================================

# ─── Credentials (THE ONLY THINGS YOU NEED TO SET) ────────────────────
GOOGLE_API_KEY=REPLACE_WITH_REAL_GOOGLE_API_KEY
MIRO_ACCESS_TOKEN=REPLACE_WITH_REAL_MIRO_TOKEN
ASANA_ACCESS_TOKEN=REPLACE_WITH_REAL_ASANA_TOKEN

# ─── Admin Panel ──────────────────────────────────────────────────────
ADMIN_PASSWORD=admin
SESSION_SECRET=super-secret-session-key-change-in-prod
ADMIN_PORT=3000

# ─── Proxy ────────────────────────────────────────────────────────────
PROXY_PORT=8888
MGMT_PORT=8889
RUST_LOG=info
