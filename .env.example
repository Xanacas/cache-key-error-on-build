# ==========================================================================
# API Proxy – Environment Configuration
#
# Copy this file:  cp .env.example .env
# Everything is pre-configured with sensible defaults.
#
# Credentials (Google, Miro, Asana) are managed through the admin panel:
#   1. docker compose up --build
#   2. Open http://localhost:3000
#   3. Log in (password below)
#   4. Go to Credentials and fill in real values
# ==========================================================================

# ─── Admin Panel ──────────────────────────────────────────────────────
ADMIN_PASSWORD=admin
SESSION_SECRET=super-secret-session-key-change-in-prod
ADMIN_PORT=3000

# ─── Proxy ────────────────────────────────────────────────────────────
PROXY_PORT=8888
MGMT_PORT=8889
RUST_LOG=info
